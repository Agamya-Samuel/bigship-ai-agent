# Frontend environment — baked at `npm run build` / docker build time.
# Copy to `.env` for local dev. Never commit real `.env`.
VITE_API_URL=http://localhost:8000
# Production options:
# - Same-origin via nginx proxy (recommended, no CORS): VITE_API_URL=
# - Split domains (frontend + api.example.com): VITE_API_URL=https://api.example.com
