# Bigship AI Agent — backend environment variables.
# Copy to `.env` and fill in real values. Never commit real `.env`.

# --- Required: secrets / model (same in every env) ---
OPENROUTER_API_KEY=
LLM_MODEL=
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# --- Deployment: change per environment ---
# Comma-separated allowed CORS origins for split-domain deploys.
# Single-domain (nginx proxy) → set to your public origin, e.g. https://app.example.com
FRONTEND_ORIGIN=http://localhost:5173
# SQLite path. Compose mounts ./data:/data so prod default just works.
# CHECKPOINT_DB_PATH=/data/checkpoints.db
# AGENT_PORT=8000
# MAX_TOOL_CALLS=10
# JWT_EXPIRY_MINUTES=1440

